datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email    String? @unique
  username String? @unique
  isAdmin  Boolean @default(false)

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  role      String   @default("client")
  status    String   @default("active")
  fullName  String?

  // Google Calendar integration (per-user OAuth tokens)
  googleCalendarAccessToken  String?
  googleCalendarRefreshToken String?
  googleCalendarTokenExpiry  DateTime?
  googleCalendarEmail        String?

  activities   ActivityLog[]
  projectNotes ProjectNote[]
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  legalName    String?
  email        String?
  phone        String?
  address      String?
  city         String?
  province     String  @default("QC")
  postalCode   String?
  country      String  @default("Canada")
  website      String?
  neq          String?
  taxNumberGst String?
  taxNumberQst String?
  currency     String  @default("CAD")
  locale       String  @default("fr-CA")

  // Branding (used in generated PDFs / public docs).
  brandLogoKey        String?
  brandPrimaryColor   String? @default("#0E0E0E")
  brandAccentColor    String? @default("#D4A24C")
  brandTextColor      String? @default("#1A1A1A")
  brandTagline        String?
  brandDescription    String? // Short description of services, shown in prospection emails
  brandEmailSignature String?

  // Courriel sortant (SMTP) — per-company, managed in Paramètres → Intégrations.
  // smtpPassword is a secret: never returned to the client. When these are empty
  // the platform SMTP_* environment config is used instead. Wasp's own auth mails
  // (vérification, réinitialisation) always use the platform config.
  smtpHost      String?
  smtpPort      Int?
  smtpUsername  String?
  smtpPassword  String?
  smtpFromName  String?
  smtpFromEmail String?

  // Every client-facing email carries Reply-To: `email` above, so replies land in
  // the company inbox rather than on the sending mailbox or the user's account.
  // When true, that same address is also put in Cci of each client send, giving
  // the company the exact message as the client received it.
  copySentEmailsToCompany Boolean @default(false)

  // SMS (Telnyx) — per-company credentials, managed in Paramètres → Intégrations.
  // telnyxApiKey and telnyxPublicKey are secrets: never returned to the client.
  // The phone number is unique so an inbound webhook maps to exactly one company.
  telnyxPhoneNumber String? @unique
  telnyxApiKey      String?
  telnyxPublicKey   String?

  // Who gets told about an incoming prospect SMS reply. Only the company's own
  // `email` / `phone` above are ever notified — never individual user accounts.
  notifySmsReplyByEmail Boolean @default(true)
  notifySmsReplyBySms   Boolean @default(false)

  // Boîte SMS universelle : la bulle flottante qui réunit tous les fils, y
  // compris ceux qui ne sont rattachés à aucun prospect. Opt-in — une entreprise
  // qui n'utilise Telnyx que pour la prospection n'en veut pas.
  smsInboxEnabled Boolean @default(false)

  // Modalités (business terms & payment conditions)
  modalityDownpaymentPercent Float?
  modalityPaymentMethods     String? // JSON array: ["interac","virement","stripe","cheque","cash","financement"]
  modalityPaymentTermsDays   Int?
  modalityLateFeePercent     Float?
  modalityDepositRequired    Boolean @default(false)
  modalityWarrantyMonths     Int?
  modalityWarrantyDetails    String?
  modalityCancellationPolicy String?
  modalityContractTerms      String?

  users               User[]
  clients             Client[]
  projects            Project[]
  documents           Document[]
  payments            Payment[]
  meetings            Meeting[]
  automations         Automation[]
  priceItems          PriceItem[]
  priceCategories     PriceCategory[]
  activities          ActivityLog[]
  templates           DocumentTemplate[]
  leadSearches        LeadSearch[]
  prospectStatuses    ProspectStatus[]
  leadStatusConfigs   LeadStatusConfig[]
  leadNotes           LeadNote[]
  leadEmailLogs       LeadEmailLog[]
  leadEmailDrafts     LeadEmailDraft[]
  leadSmsLogs         LeadSmsLog[]
  smsContacts         SmsContact[]
  prospectTemplates   ProspectTemplate[]
  leadShareTokens     LeadSearchShareToken[]
  leadInboundWebhooks LeadInboundWebhook[]
}

model Client {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  province    String  @default("QC")
  postalCode  String?
  notes       String?
  status      String  @default("actif")

  projects   Project[]
  documents  Document[]
  meetings   Meeting[]
  activities ActivityLog[]
  files      ClientFile[]
}

model ClientFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  name     String
  isFolder Boolean @default(false)
  parentId String?
  key      String?
  mimeType String?
  size     Int     @default(0)

  sourceTemplateId   String?
  sourceTemplateType String?
  dynamicVars        String? // JSON: Record<string, string> of variable overrides
  sourceTemplate     DocumentTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  name        String
  description String?
  status      String  @default("en_cours")

  notifyAdminOnClientActivity Boolean @default(false)
  notifyClientOnActivity      Boolean @default(false)

  documents    Document[]
  tasks        ProjectTask[]
  notes        ProjectNote[]
  clientAccess ProjectClientAccess[]
  files        ProjectFile[]
  activities   ActivityLog[]
}

model ProjectTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title       String
  description String?
  status      String  @default("todo") // todo | in_progress | done
  priority    String  @default("medium") // low | medium | high
  sortOrder   Int     @default(0)
}

model ProjectNote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  content      String
  isPrivate    Boolean @default(false) // visible only to internal users, not client portal
  isFromClient Boolean @default(false)
  authorName   String? // for client-submitted notes

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?
}

model ProjectClientAccess {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  token      String    @unique
  label      String?
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime?
  lastUsedAt DateTime?
}

model ProjectFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  name     String
  isFolder Boolean @default(false)
  parentId String? // null = root of project

  // Only for files (isFolder = false)
  key      String? // MinIO object key
  mimeType String?
  size     Int     @default(0)

  parent   ProjectFile?  @relation("PFTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectFile[] @relation("PFTree")
}

model Document {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  // 'quote' | 'invoice' — same record can be promoted from quote to invoice.
  type                String    @default("quote")
  number              String
  title               String?
  description         String?
  status              String    @default("actif")
  issueDate           DateTime  @default(now())
  validUntil          DateTime?
  dueDate             DateTime?
  discountType        String    @default("percent")
  discountValue       Float     @default(0)
  subtotal            Float     @default(0)
  taxGst              Float     @default(0)
  taxQst              Float     @default(0)
  total               Float     @default(0)
  amountPaid          Float     @default(0)
  notes               String?
  emailSubjectQuote   String?
  emailBodyQuote      String?
  emailSubjectInvoice String?
  emailBodyInvoice    String?
  emailTo             String?
  emailCc             String?
  statusLocked        Boolean   @default(false)

  items      DocumentItem[]
  payments   Payment[]
  activities ActivityLog[]

  @@unique([companyId, number])
}

model DocumentItem {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  description String
  note        String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
}

model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  amount    Float
  method    String   @default("virement")
  paidAt    DateTime @default(now())
  reference String?
  notes     String?
}

model Meeting {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  meetingUrl  String?
  status      String    @default("prevue")

  // Google Calendar sync
  googleCalendarEventId String?
  meetLink              String? // Google Meet URL
  attendeeEmails        String? // JSON array of email strings

  archived Boolean @default(false)
}

model PriceItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  code        String?
  name        String
  description String?
  category    String?
  unit        String  @default("unite")
  unitPrice   Float   @default(0)
  isActive    Boolean @default(true)
}

model PriceCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name String

  @@unique([companyId, name])
}

model Automation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name        String
  description String?
  trigger     String
  action      String
  isActive    Boolean @default(true)
  config      Json?
}

model ActivityLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  type     String
  message  String
  metadata Json?

  notificationRecipient String? // 'admin' | 'client' — queued for email digest; null = no email
  notifiedAt            DateTime? // set by cron once digest email is sent

  @@index([companyId, createdAt])
  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
  @@index([notificationRecipient, notifiedAt])
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name        String
  type        String  @default("autre") // contract | cahier_des_charges | hebergement | maintenance | autre
  description String?
  content     String  @default("") // Markdown body
  isActive    Boolean @default(true)

  clientFiles ClientFile[]

  @@index([companyId])
}

model LeadSearch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  title       String
  description String?
  purpose     String?
  filters     Json    @default("{}")
  status      String  @default("done") // running | done | error
  errorMsg    String?
  totalFound  Int     @default(0)

  // Comment ce tableau se remplit : google_maps | webhook | manual.
  // Une colonne plutôt qu'un test `inboundWebhook != null` : toute l'interface s'y
  // branche, et elle reste juste pour un tableau dont le webhook a été supprimé.
  // Les tableaux existants sont tous des recherches Google, d'où la valeur par défaut.
  kind String @default("google_maps")

  leads          Lead[]
  templates      ProspectTemplate[]
  shareToken     LeadSearchShareToken?
  inboundWebhook LeadInboundWebhook?
  statusConfigs  LeadStatusConfig[]

  @@index([companyId])
}

model Lead {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  search   LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String

  name            String
  address         String?
  phone           String?
  website         String?
  email           String?
  rating          Float?
  reviewCount     Int?
  category        String?
  placeId         String?
  // Identifiant du prospect chez la source externe (clé anti-doublon d'un appel
  // entrant). Distinct de placeId, qui est une identité *d'entreprise* réutilisable
  // d'une recherche à l'autre ; un envoi de formulaire est un événement unique qui
  // ne se reproduit jamais. Volontairement non unique : une seconde source pourra
  // réutiliser la même valeur sans collision.
  externalId      String?
  mapsUrl         String?
  latitude        Float?
  longitude       Float?
  isOpen          Boolean?
  notes           String?
  status          String    @default("nouveau") // nouveau | contacte | qualifie | rejete
  // Where the prospect came from: google_maps | manual | facebook | instagram |
  // linkedin | referral | website | other. Existing rows predate manual entry,
  // so they all came from the Google Maps search.
  source          String    @default("google_maps")
  statusUpdatedAt DateTime?
  order           Int       @default(0) // manual position inside its kanban column

  @@index([searchId])
  @@index([externalId])
}

// A reusable message model of a prospection search. Kept on the original
// `ProspectEmailTemplate` table (hence the @@map) since it started life as the
// single email template each search had.
model ProspectTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  search   LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String

  // ASCII default on purpose: the wasp prisma pipeline garbles accents in
  // default values, and existing rows inherit this name on migration.
  name    String @default("Courriel")
  channel String @default("email") // email | sms
  subject String @default("") // unused for sms
  body    String @default("")

  // Status key this model is proposed for by default, e.g. "nouveau".
  // At most one model per search + channel + status.
  defaultStatus String?

  @@index([companyId])
  @@index([searchId, channel])
  @@map("ProspectEmailTemplate")
}

model LeadStatusConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Null : les statuts de l'entreprise, ceux que règle « Statuts » sur la page
  // Prospection et que tous les tableaux suivent par défaut.
  // Non nul : le jeu propre à ce tableau, qui **remplace entièrement** celui de
  // l'entreprise. Tout ou rien, jamais une fusion des deux — un tableau qui
  // hériterait de la moitié des colonnes serait impossible à raisonner, et
  // renommer un statut d'entreprise donnerait des résultats imprévisibles.
  search   LeadSearch? @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String?

  key   String // e.g. "nouveau", "en_negociation"
  label String // e.g. "Nouveau", "En négociation"
  color String @default("#6366f1") // hex color for the column header
  order Int    @default(0)

  // Postgres considère deux NULL comme distincts : cette contrainte ne protège
  // donc pas les statuts d'entreprise entre eux. `createLeadStatusConfig` vérifie
  // explicitement l'unicité de la clé — voir le commentaire qui l'accompagne.
  @@unique([companyId, searchId, key])
  @@index([companyId])
  @@index([searchId])
}

// Persistent status/notes for a prospect across all searches
model ProspectStatus {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  placeId String
  status  String  @default("nouveau")
  notes   String?

  @@unique([companyId, placeId])
  @@index([companyId])
}

// Timeline notes for a prospect (keyed by placeId if available, else lead.id)
model LeadNote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  identifier String // placeId when available, else lead.id
  text       String

  @@index([companyId, identifier])
}

// Sent email log for a prospect (append-only, keyed by identifier)
model LeadEmailLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  identifier String // placeId when available, else lead.id
  to         String
  cc         String?
  subject    String
  body       String  @default("") // full message as sent, for preview
  replyTo    String? // where the prospect's reply lands
  fromName   String? // display name used in the From header
  fromEmail  String? // address used in the From header

  @@index([companyId, identifier])
}

// SMS conversation with a prospect, keyed by identifier. Holds both directions:
// outbound rows are written when we send, inbound rows by the Telnyx webhook.
model LeadSmsLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // placeId when available, else lead.id — or `tel:+15145550100` for a thread
  // with a number that belongs to no prospect (see directIdentifier in server/sms.ts).
  identifier String
  to         String // E.164 number the message was sent to
  fromNumber String // Telnyx number it was sent from
  body       String  @default("")
  providerId String? @unique // Telnyx message id — also the webhook idempotency key

  direction String    @default("outbound") // "outbound" | "inbound"
  status    String? // Telnyx delivery state: queued | sent | delivered | sending_failed | delivery_failed | received
  errorCode String? // Telnyx error code when a send fails
  readAt    DateTime? // inbound only: when someone opened the thread

  // Alerte de réponse différée (entrants seulement) — voir
  // server/jobs/smsReplyAlerts.ts. Aucune alerte ne part à la réception :
  // l'échéance est posée ici, et la tâche planifiée ne poste courriel *et* SMS
  // que si le message est toujours non lu à ce moment-là. Lu à temps =
  // `replyAlertDueAt` remis à NULL et rien d'envoyé sur aucun canal.
  replyAlertDueAt       DateTime? // échéance ; NULL = aucune alerte en attente
  replyAlertSentAt      DateTime? // clôture du cycle ; NULL = alerte encore vivante
  // Le volet courriel est réglé en une passe (parti, refusé ou échoué) : il ne
  // coûte rien mais ne se réessaie pas, alors que le SMS retente chaque minute.
  // Sans ce marqueur distinct, une reprise SMS renverrait le courriel.
  replyAlertEmailSentAt DateTime?

  // Covers the plain (companyId, identifier) prefix too; createdAt is what the
  // inbox needs to pick each thread's last message.
  @@index([companyId, identifier, createdAt])
  // Attribution lookup: match an inbound number back to the last outbound message.
  @@index([to, direction, createdAt])
  // La tâche planifiée balaie les échéances chaque minute : peu de lignes
  // concernées, mais un scan complet de la table à chaque passage sans index.
  @@index([replyAlertDueAt])
}

// Lightweight directory: puts a name on a number that is neither a client nor a
// prospect, so the inbox shows "Jean Tremblay" rather than a raw +1…
// Deliberately no foreign key to LeadSmsLog — threads are keyed by an opaque
// string and outlive the contact.
model SmsContact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  phone String // E.164 only — normalised through toE164 before it is written
  name  String
  note  String?

  @@unique([companyId, phone])
  @@index([companyId, name])
}

// OBSOLÈTE depuis la boîte SMS universelle : un entrant non attribué crée
// désormais une vraie conversation `tel:+…`. Table conservée en archive — ses
// lignes ont été reversées dans LeadSmsLog par la migration sms_inbox. Plus
// aucune écriture. À supprimer dans une migration ultérieure.
model SmsInboundUnmatched {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  providerId String? @unique
  fromNumber String // E.164 number that texted us
  to         String // our Telnyx number it arrived on
  body       String  @default("")

  @@index([createdAt])
}

// Shareable link token for an employee to access prospect details (no login)
model LeadSearchShareToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  search   LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String     @unique

  token      String    @unique
  label      String?
  isRevoked  Boolean   @default(false)
  lastUsedAt DateTime?

  @@index([companyId])
}

// Draft email content for a prospect (one per identifier, upserted)
model LeadEmailDraft {
  id String @id @default(uuid())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  identifier String
  to         String @default("")
  cc         String @default("")
  subject    String @default("")
  body       String @default("")

  @@unique([companyId, identifier])
  @@index([companyId, identifier])
}

// ─── Réception de prospects par webhook ───────────────────────────────────────
// Un tableau alimenté par webhook a une adresse publique permanente et un secret
// que l'on peut faire tourner sans casser l'adresse. C'est tout l'intérêt de les
// séparer : l'URL vit dans une configuration Zapier, un script Google Sheets et
// le HTML d'un site — changer de secret ne doit pas obliger à tout reconfigurer.
model LeadInboundWebhook {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Un tableau, un webhook. Cascade : sans tableau l'adresse n'a plus de cible et
  // doit cesser d'exister, pas rester ouverte sur le vide.
  search   LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String     @unique

  // Identifiant public, celui de l'URL. IMMUABLE : aucune opération ne le modifie.
  publicId        String    @unique
  // Secret partagé, en-tête X-Gestia-Secret. Rotatif. Jamais renvoyé au client
  // sauf demande explicite d'un administrateur — il est fait pour être recopié
  // ailleurs, contrairement à telnyxApiKey ou smtpPassword.
  secret          String
  secretRotatedAt DateTime?

  // Correspondance champs JSON reçus → champs du prospect (voir shared/leadIntake).
  // `{}` = pas encore configurée : le point d'entrée capture sans rien créer, ce
  // qui est exactement l'état « test » dont on a besoin pour construire la
  // correspondance à partir d'un vrai appel.
  mapping Json @default("{}")

  isActive       Boolean   @default(true)
  receivedCount  Int       @default(0)
  lastReceivedAt DateTime?

  // Qui est prévenu quand un prospect arrive ici (voir jobs/leadIntake).
  //
  // Par source et non par entreprise : on reçoit rarement de la même façon d'un
  // formulaire Facebook et d'un tableur de rappels. Une entreprise veut être
  // alertée sur le tableau qui compte, pas sur les six.
  //
  // Les deux à `false` : une alerte est une interruption, et le SMS est facturé.
  // On les demande, elles ne se subissent pas. Les coordonnées visées restent
  // celles de l'entreprise — jamais un compte individuel.
  notifyByEmail Boolean @default(false)
  notifyBySms   Boolean @default(false)

  // Repère de la dernière alerte « prospects reçus » : la tâche ne réexpédie que
  // ce qui est arrivé après. Sans cette borne, chaque passage renverrait tout
  // l'historique de la journée.
  notifiedAt DateTime?

  events LeadInboundEvent[]

  @@index([companyId])
}

// Journal de chaque appel reçu, écrit AVANT toute création de prospect. Il porte
// à lui seul l'idempotence, sert d'échantillon à la correspondance, rend visible
// un Zapier mal configuré, et permet de rejouer. Purgé à 90 jours.
model LeadInboundEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  webhook   LeadInboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId String
  companyId String

  // Valeur du champ anti-doublon désigné par la correspondance (external_id,
  // leadgen_id, numéro de ligne…). Null quand l'émetteur n'en fournit pas : on
  // n'invente pas de clé à partir du contenu, sinon deux demandes légitimes de la
  // même personne n'en feraient qu'une.
  dedupeKey String?

  // captured | ok | duplicate | rejected | error
  // `captured` = reçu avant qu'une correspondance existe ; sert d'échantillon.
  status   String   @default("captured")
  errorMsg String?
  payload  Json     @default("{}") // corps reçu, secret retiré
  sourceIp String?
  // Colonnes simples, sans clé étrangère — comme LeadNote.identifier : supprimer
  // un prospect ne doit ni effacer la trace, ni rouvrir la porte à un doublon.
  leadIds  String[] @default([])

  @@unique([webhookId, dedupeKey])
  @@index([webhookId, createdAt])
}
