// Surcharge des statuts par tableau : un tableau qui a les siens n'hérite plus
// de ceux de l'entreprise, ni en tout ni en partie.
action overrideBoardStatuses {
  fn: import { overrideBoardStatuses } from "@src/app/leads/operations",
  entities: [User, LeadStatusConfig, LeadSearch]
}
action resetBoardStatuses {
  fn: import { resetBoardStatuses } from "@src/app/leads/operations",
  entities: [User, LeadStatusConfig, LeadSearch, Lead]
}
