// Hourly background sweep that advances document statuses based on time
// (quotes → expiree after validUntil, invoices → en_retard after dueDate).
// Runs every hour to advance document statuses based on time:
//   - quotes 'envoyee' past dueDate      → 'expiree'
//   - invoices 'envoyee'/'acompte_recu'
//     past dueDate                       → 'en_retard'
job documentLifecycleSweep {
  executor: PgBoss,
  perform: {
    fn: import { sweepDocumentLifecycles } from "@src/server/jobs/documentLifecycle"
  },
  schedule: {
    cron: "0 * * * *"
  },
  entities: [Document, ActivityLog]
}
