  entities: []
}

// ─── Telnyx SMS webhooks ──────────────────────────────────────────────────────
// Prospect replies and delivery receipts. Both URLs go to the same idempotent
// handler; the failover path is what Telnyx retries when the first one errors.
// Configure on the Messaging Profile:
//   https://api.gestia.trifali.app/webhooks/telnyx/sms
//   https://api.gestia.trifali.app/webhooks/telnyx/sms-failover
apiNamespace telnyxWebhooks {
  middlewareConfigFn: import { telnyxWebhookMiddleware } from "@src/server/smsWebhook",
  path: "/webhooks/telnyx"
}

api telnyxSmsWebhook {
  fn: import { telnyxSmsWebhook } from "@src/server/smsWebhook",
  httpRoute: (POST, "/webhooks/telnyx/sms"),
  entities: [User, Company, Lead, LeadSmsLog, SmsContact, Client],
  auth: false
}

api telnyxSmsWebhookFailover {
  fn: import { telnyxSmsWebhook } from "@src/server/smsWebhook",
  httpRoute: (POST, "/webhooks/telnyx/sms-failover"),
  entities: [User, Company, Lead, LeadSmsLog, SmsContact, Client],
  auth: false
}

// ─── Réception de prospects ───────────────────────────────────────────────────
// Une adresse permanente par tableau, un secret rotatif dans l'en-tête
// X-Gestia-Secret. Alimentée par Zapier/Make (formulaires Facebook), un script
// Google Sheets, ou le formulaire d'un site web :
//   https://api.gestia.trifali.app/webhooks/prospects/<publicId>
//
// L'espace de nommage remplace l'analyse de corps par une qui accepte aussi
// l'urlencodé — c'est ce qui permet à un <form> HTML de poster directement.
apiNamespace leadIntakeWebhooks {
  middlewareConfigFn: import { leadIntakeMiddleware } from "@src/server/leadIntake/webhook",
  path: "/webhooks/prospects"
}

api leadIntakeReceive {
  fn: import { leadIntakeReceive } from "@src/server/leadIntake/webhook",
  httpRoute: (POST, "/webhooks/prospects/:publicId"),
  entities: [Company, LeadSearch, Lead, LeadNote, LeadStatusConfig, LeadSourceConfig, LeadInboundWebhook, LeadInboundEvent],
  auth: false
}

// GET séparé plutôt qu'un ALL : ouvrir l'adresse dans un navigateur doit dire
// quelque chose d'utile, et cette réponse ne lit ni le secret ni les prospects.
api leadIntakePing {
  fn: import { leadIntakePing } from "@src/server/leadIntake/webhook",
  httpRoute: (GET, "/webhooks/prospects/:publicId"),
  entities: [LeadInboundWebhook],
  auth: false
}

// Hourly background sweep that advances document statuses based on time
// (quotes → expiree after validUntil, invoices → en_retard after dueDate).
// Runs every hour to advance document statuses based on time:
//   - quotes 'envoyee' past dueDate      → 'expiree'
//   - invoices 'envoyee'/'acompte_recu'
//     past dueDate                       → 'en_retard'
job documentLifecycleSweep {
  executor: PgBoss,
  perform: {
    fn: import { sweepDocumentLifecycles } from "@src/server/jobs/documentLifecycle"
  },
  schedule: {
    cron: "0 * * * *"
  },
  entities: [Document, ActivityLog]
}

// Chaque minute : poste les alertes de réponse arrivées à échéance, courriel
// comme SMS.
//
// Le webhook Telnyx ne notifie plus personne lui-même — il date la réponse à
// +5 minutes. Ce balayage n'alerte que sur ce qui est *encore non lu* à
// l'échéance : une réponse vue dans Gestia entre-temps ne coûte pas un SMS et
// n'encombre pas la boîte de courriel. À la minute, parce qu'un délai de
// 5 minutes annoncé à l'utilisateur doit être tenu à la minute près ; la requête
// est indexée sur `replyAlertDueAt` et ne coûte rien à vide.
job sendDueSmsReplyAlerts {
  executor: PgBoss,
  perform: {
    fn: import { sendDueSmsReplyAlerts } from "@src/server/jobs/smsReplyAlerts"
  },
  schedule: {
    cron: "* * * * *"
  },
  // Lead / SmsContact / Client : `resolveDisplayName` nomme l'interlocuteur.
  entities: [LeadSmsLog, Company, Lead, SmsContact, Client]
}

// Every 5 minutes: send batched project notification emails (admin ← client activity, client ← admin activity)
// Entretien de la réception de prospects. Rien ici n'est nécessaire à
// l'acheminement — un appel entrant crée sa carte immédiatement.

// Purge quotidienne du journal des appels (90 jours), en épargnant le plus
// récent de chaque source : c'est lui qui sert d'échantillon à l'écran de
// correspondance quand on veut la reconfigurer.
job sweepLeadInboundEvents {
  executor: PgBoss,
  perform: {
    fn: import { sweepLeadInboundEvents } from "@src/server/jobs/leadIntake"
  },
  schedule: {
    cron: "30 4 * * *"
  },
  entities: [LeadInboundWebhook, LeadInboundEvent]
}

// Toutes les 5 minutes : prévient l'entreprise des prospects arrivés que
// personne n'a encore ouverts. Même logique différée que les alertes de réponse
// SMS — un prospect déjà déplacé de sa colonne d'arrivée a été vu, et ne
// déclenche rien.
job notifyInboundLeads {
  executor: PgBoss,
  perform: {
    fn: import { notifyInboundLeads } from "@src/server/jobs/leadIntake"
  },
  schedule: {
    cron: "*/5 * * * *"
  },
  entities: [LeadInboundWebhook, Lead, Company]
}

job sendProjectNotifications {
  executor: PgBoss,
  perform: {
    fn: import { sendProjectNotifications } from "@src/server/jobs/sendProjectNotifications"
  },
  schedule: {
    cron: "*/5 * * * *"
  },
  entities: [ActivityLog, Project, Company, Client]
}
