  entities: [User, LeadStatusConfig, Lead, LeadSearch]
}
action reorderLeadStatusConfigs {
  fn: import { reorderLeadStatusConfigs } from "@src/app/leads/operations",
  entities: [User, LeadStatusConfig]
}

// Champs de carte : ce que montre une carte du kanban, à deux portées comme les
// statuts. Le jeu de l'entreprise vaut par défaut ; un tableau peut le remplacer
// entièrement, et `resetLeadCardFields` est le seul chemin de retour.
query getLeadCardFields {
  fn: import { getLeadCardFields } from "@src/app/leads/operations",
  entities: [User, LeadCardFieldConfig, LeadSearch]
}
action saveLeadCardFields {
  fn: import { saveLeadCardFields } from "@src/app/leads/operations",
  entities: [User, LeadCardFieldConfig, LeadSearch]
}
action resetLeadCardFields {
  fn: import { resetLeadCardFields } from "@src/app/leads/operations",
  entities: [User, LeadCardFieldConfig, LeadSearch]
}

// Provenances : le registre de l'entreprise. Pas de portée par tableau — une
// provenance dit d'où vient le prospect, pas où on le regarde.
