# Gestia — variables d'environnement (serveur)

# Base de données
# Si vous utilisez `wasp start db` (recommandé en local), laissez DATABASE_URL commenté.
# Wasp configurera automatiquement la connexion à la base PostgreSQL Docker.
# DATABASE_URL=postgresql://user:password@localhost:5432/gestia

# Comptes administrateurs
# Liste séparée par des virgules. Toute personne s'inscrivant avec un de ces courriels
# obtient automatiquement le rôle administrateur.
ADMIN_EMAILS=info@trifali.com

# Désactiver les nouvelles inscriptions (protège aussi l'API backend)
DISABLE_SIGNUP=true

# sms (Telnyx)
# Aucune variable d'environnement : le numéro, la clé API et la clé publique
# se configurent par entreprise dans Paramètres → Intégrations, qui affiche
# aussi les deux URL de webhook à coller dans le portail Telnyx.

# courriel (SMTP) — configuration de la PLATEFORME uniquement
# Ces identifiants ne servent QU'aux courriels que Gestia envoie en son nom :
#   1. authentification (vérification d'adresse, mot de passe oublié) — envoyés
#      par Wasp via `emailSender` dans main.wasp ;
#   2. le formulaire de contact public, qui n'a pas d'entreprise associée.
# Le courriel d'affaires (devis, factures, prospection, notifications) utilise
# EXCLUSIVEMENT le serveur SMTP propre à chaque entreprise, configuré dans
# Paramètres → Intégrations. Il n'y a aucun repli : une entreprise sans serveur
# configuré ne peut pas envoyer de courriels.
SMTP_HOST=smtp.exemple.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@exemple.com
SMTP_PASSWORD=
